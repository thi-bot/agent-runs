[
  {
    "name": "contact",
    "goal": "Find the company's contact information (an email address or phone number).",
    "hints": [
      "contact",
      "contact us",
      "get in touch",
      "support"
    ],
    "safety": "read-only",
    "max_steps": 12,
    "success": [
      {
        "navigated": true
      },
      {
        "any_of": [
          {
            "url": {
              "regex": "(^|/)(contact|contact-us|contacto|contactos|support|kontakt)(/|\\.|$|\\?)"
            }
          },
          {
            "element": {
              "role": "link",
              "url": "mailto:"
            }
          },
          {
            "element": {
              "role": "link",
              "url": "tel:"
            }
          },
          {
            "element": {
              "role": "heading",
              "name": "contact"
            }
          }
        ]
      }
    ]
  },
