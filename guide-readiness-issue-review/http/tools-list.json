                "minLength": 1,
                "title": "Url",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "title": "fetch_docs_pageArguments"
          },
          "name": "fetch_docs_page"
        }
      ],
      "ttlMs": 3600000,
      "_meta": {
        "io.modelcontextprotocol/serverInfo": {
          "name": "wagtail-guide",
          "title": "Wagtail Guide",
          "version": "1.0.0",
